{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^4.4",
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.2",
        "laravel/slack-notification-channel": "^3.8",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^4.3",
        "maatwebsite/excel": "^3.1",
        "meilisearch/meilisearch-php": "^1.16",
        "predis/predis": "^3.4",
        "pusher/pusher-php-server": "*",
        "resend/resend-laravel": "^1.3",
        "spatie/laravel-permission": "^6.25",
        "symfony/http-client": "^7.4",
        "symfony/mailgun-mailer": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/AuthHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#a5f3fc,#fb7185,#f9a8d4,#fdba74,#fde68a,#86efac,#c4b5fd\" \"php artisan serve\" \"npm run dev\" \"php artisan queue:listen --queue=realtime --tries=1\" \"php artisan queue:listen --queue=emails --tries=1\" \"php artisan queue:listen --queue=notifications --tries=1\" \"php artisan queue:listen --queue=default --tries=1\" \"php artisan queue:listen --queue=pdfs --tries=1\" \"php artisan queue:listen --queue=analytics --tries=1\" --names=server,vite,queue:realtime,queue:emails,queue:notifications,queue:default,queue:pdfs,queue:analytics --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
